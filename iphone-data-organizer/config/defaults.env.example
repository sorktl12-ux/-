# Mac+iPhone 데이터 정리 설정
# 이 파일을 defaults.env 로 복사한 뒤 경로를 수정하세요.
# cp config/defaults.env.example config/defaults.env

# iCloud Drive 루트 (macOS 기본값)
ICLOUD_DRIVE="$HOME/Library/Mobile Documents/com~apple~CloudDocs"

# 정리 대상 폴더 (iPhone과 iCloud로 동기화되는 경로)
DOWNLOADS_FOLDER="$ICLOUD_DRIVE/Downloads"
KAKAOTALK_FOLDERS=(
  "$ICLOUD_DRIVE/KakaoTalk"
  "$ICLOUD_DRIVE/kakao"
  "$HOME/Library/Mobile Documents/com~apple~CloudDocs/KakaoTalk"
)

# iPhone '내 iPhone' 저장소는 Mac에서 직접 접근 불가.
# 아래는 Mac 로컬 백업/임포트 경로입니다.
IPHONE_IMPORT_ROOT="$HOME/Pictures/iPhone Import"
IPHONE_BACKUP_ROOT="$HOME/Library/Application Support/MobileSync/Backup"
ORGANIZED_ROOT="$ICLOUD_DRIVE/Organized"

# 사진 정리: iCloud 사진 라이브러리 사용 시
PHOTOS_LIBRARY="$HOME/Pictures/Photos Library.photoslibrary"

# 중복 파일 처리: skip | rename | delete
DUPLICATE_POLICY="skip"

# 드라이런: true면 실제 이동 없이 로그만 출력
DRY_RUN="false"

# pymobiledevice3: USB 연결 iPhone 사진 가져오기
ENABLE_USB_IMPORT="true"
